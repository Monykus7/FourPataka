{
  "name": "fourpataka",
  "version": "0.22.0",
  "description": "Fourier instrument and composition studio",
  "author": "Monykus7",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests desktop scripts *.ts *.json",
    "format:check": "prettier --check src tests desktop scripts *.ts *.json",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "electron .",
    "desktop:package": "npm run build && electron-builder --win portable --x64 --publish never",
    "test:desktop": "npm run build && playwright test --config playwright.desktop.config.ts",
    "knowledge:build": "node scripts/knowledge/cli.mjs build",
    "knowledge:check": "node scripts/knowledge/cli.mjs check",
    "knowledge:embed": "node scripts/knowledge/cli.mjs embed",
    "knowledge:query": "node scripts/knowledge/cli.mjs query",
    "knowledge:watch": "node scripts/knowledge/watch.mjs",
    "knowledge:verify": "node scripts/knowledge/verify.mjs"
  },
  "build": {
    "appId": "com.fourpataka.studio",
    "productName": "FourPataka",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "portable": {
      "useZip": true
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "FourPataka-${version}-win-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/dm-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@codemirror/commands": "^6.11.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "js-tiktoken": "^1.0.21",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
